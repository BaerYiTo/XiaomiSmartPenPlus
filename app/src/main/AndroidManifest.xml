<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <provider android:authorities="com.focuspenlite.config" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:allowBackup="false" android:supportsRtl="true" android:theme="@style/Theme.FocusPen"
        android:directBootAware="true">
        <activity android:name="xiaomismartpen.plus.ConfigActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name="xiaomismartpen.plus.ConfigProvider"
            android:authorities="com.inkdye.xiaomipen.config" android:exported="true" android:directBootAware="true" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposeddescription" android:value="@string/module_description" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
